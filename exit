[32m+[m[32m/* ============================================================[m
[32m+[m[32m *  CRC-16 (Modbus polynomial 0xA001)[m
[32m+[m[32m * ============================================================ */[m
[32m+[m[32mstatic uint16_t modbus_crc16(const uint8_t *buf, uint16_t len)[m
[32m+[m[32m{[m
[32m+[m[32m    uint16_t crc = 0xFFFF;[m
[32m+[m[32m    for (uint16_t i = 0; i < len; i++)[m
[32m+[m[32m    {[m
[32m+[m[32m        crc ^= buf[i];[m
[32m+[m[32m        for (uint8_t b = 0; b < 8; b++)[m
[32m+[m[32m        {[m
[32m+[m[32m            if (crc & 0x0001)[m
[32m+[m[32m                crc = (crc >> 1) ^ 0xA001;[m
[32m+[m[32m            else[m
[32m+[m[32m                crc >>= 1;[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m[32m    return crc;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m *  Modbus register read  (returns 0xFFFF for invalid addr)[m
[32m+[m[32m * ============================================================ */[m
[32m+[m[32mstatic uint16_t modbus_read_register(uint16_t addr)[m
[32m+[m[32m{[m
[32m+[m[32m    switch (addr)[m
[32m+[m[32m    {[m
