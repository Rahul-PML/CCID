[32m+[m[32m        case MB_REG_AC_CURRENT:  return mb_ac_current;[m
[32m+[m[32m        case MB_REG_DC_THRESH:   return mb_dc_thresh;[m
[32m+[m[32m        case MB_REG_AC_THRESH:   return mb_ac_thresh;[m
[32m+[m[32m        case MB_REG_SLAVE_ADDR:  return mb_slave_addr;[m
[32m+[m[32m        default:                 return 0xFFFF;[m
[32m+[m[32m    }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m *  Modbus register write  (returns 0=OK, 1=illegal addr/data)[m
[32m+[m[32m * ============================================================ */[m
[32m+[m[32mstatic uint8_t modbus_write_register(uint16_t addr, uint16_t value)[m
[32m+[m[32m{[m
[32m+[m[32m    switch (addr)[m
[32m+[m[32m    {[m
