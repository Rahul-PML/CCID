[32m+[m[32m            mb_dc_thresh = value;[m
[32m+[m[32m            return 0;[m
[32m+[m
[32m+[m[32m        case MB_REG_AC_THRESH:[m
[32m+[m[32m            if (value == 0) return 1;[m
[32m+[m[32m            mb_ac_thresh = value;[m
[32m+[m[32m            return 0;[m
[32m+[m
[32m+[m[32m        case MB_REG_SLAVE_ADDR:[m
[32m+[m[32m            /* Valid slave addresses: 1–247 */[m
[32m+[m[32m            if (value < 1 || value > 247) return 1;[m
[32m+[m[32m            mb_slave_addr = value;[m
[32m+[m[32m            return 0;[m
[32m+[m
[32m+[m[32m        /* Current registers are read-only */[m
[32m+[m[32m        case MB_REG_DC_CURRENT:[m
[32m+[m[32m        case MB_REG_AC_CURRENT:[m
[32m+[m[32m        default:[m
[32m+[m[32m            return 1;[m
[32m+[m[32m    }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m *  Transmit a Modbus response frame[m
[32m+[m[32m * ============================================================ */[m
[32m+[m[32mstatic void modbus_send(const uint8_t *buf, uint8_t len)[m
[32m+[m[32m{[m
[32m+[m[32m    for (uint8_t i = 0; i < len; i++)[m
[32m+[m[32m    {[m
[32m+[m[32m        while (!(USART2->ISR & USART_ISR_TXE)) {}[m
[32m+[m[32m        USART2->TDR = buf[i];[m
[32m+[m[32m    }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m *  Poll USART2 RX for incoming Modbus bytes.[m
[32m+[m[32m *  Call every main-loop iteration (~10 µs).[m
[32m+[m[32m *  Sets mb_frame_ready after MB_INTER_FRAME_MS silence.[m
[32m+[m[32m * ============================================================ */[m
[32m+[m[32mstatic void modbus_poll_rx(void)[m
[32m+[m[32m{[m
[32m+[m[32m    /* Accumulate incoming bytes */[m
[32m+[m[32m    while (USART2->ISR & USART_ISR_RXNE)[m
[32m+[m[32m    {[m
[32m+[m[32m        uint8_t ch = (uint8_t)(USART2->RDR & 0xFF);[m
[32m+[m[32m        if (mb_rx_idx < MB_FRAME_BUF)[m
[32m+[m[32m            mb_rx_buf[mb_rx_idx++] = ch;[m
[32m+[m[32m        mb_last_rx_tick = HAL_GetTick();[m
[32m+[m[32m        mb_frame_ready  = 0;   /* reset — still receiving */[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    /* Detect end-of-frame: 5 ms silence after last byte */[m
[32m+[m[32m    if (mb_rx_idx > 0 && !mb_frame_ready)[m
[32m+[m[32m    {[m
[32m+[m[32m        if ((HAL_GetTick() - mb_last_rx_tick) >= MB_INTER_FRAME_MS)[m
[32m+[m[32m        {[m
[32m+[m[32m            mb_rx_len      = mb_rx_idx;[m
[32m+[m[32m            mb_rx_idx      = 0;[m
[32m+[m[32m            mb_frame_ready = 1;[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m *  Process a complete Modbus frame.[m
[32m+[m[32m *  Supports FC 0x03 (Read Holding Registers)[m
[32m+[m[32m *  and      FC 0x10 (Write Multiple Registers).[m
[32m+[m[32m *  Responds to broadcast address 0x00 (no reply sent).[m
[32m+[m[32m * ============================================================ */[m
[32m+[m[32mstatic void modbus_process_frame(void)[m
[32m+[m[32m{[m
[32m+[m[32m    if (!mb_frame_ready) return;[m
[32m+[m[32m    mb_frame_ready = 0;[m
[32m+[m
[32m+[m[32m    /* Minimum frame length: 4 bytes (addr + func + 2 CRC) */[m
[32m+[m[32m    if (mb_rx_len < 4) return;[m
[32m+[m
[32m+[m[32m    uint8_t rx_addr = mb_rx_buf[0];[m
[32m+[m
[32m+[m[32m    /* Accept our address or broadcast 0x00 */[m
[32m+[m[32m    if (rx_addr != (uint8_t)mb_slave_addr && rx_addr != 0x00) return;[m
[32m+[m
[32m+[m[32m    /* Validate CRC */[m
